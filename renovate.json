{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "composer",
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "Group development tooling updates",
      "matchDepTypes": [
        "require-dev"
      ],
      "groupName": "dev tooling",
      "automerge": false,
      "labels": [
        "dependencies"
      ]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "automerge": false,
      "labels": [
        "dependencies",
        "ci"
      ]
    }
  ]
}
