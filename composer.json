{
    "name": "cleatsquad/php-http-replay",
    "description": "Deterministic HTTP request recording and replay for PHP 8.2+",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http",
        "replay",
        "vcr",
        "mock",
        "psr-7",
        "testing"
    ],
    "homepage": "https://github.com/cleatSquad/php-http-replay",
    "readme": "README.md",
    "authors": [
        {
            "name": "Mohamed El Mrabet",
            "email": "mimou78@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/cleatSquad/php-http-replay/issues",
        "source": "https://github.com/cleatSquad/php-http-replay"
    },
    "require": {
        "php": ">=8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0 || ^8.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Allows integrating http-replay as a Guzzle HTTP handler/middleware",
        "symfony/yaml": "Allows importing legacy YAML cassettes from PHP-VCR"
    },
    "autoload": {
        "psr-4": {
            "CleatSquad\\HttpReplay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleatSquad\\HttpReplay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
